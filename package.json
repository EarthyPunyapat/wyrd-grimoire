{
  "name": "wyrd-grimoire",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "start": "bun apps/server/src/main.ts",
    "test:e2e": "playwright test",
    "wyrd": "bun apps/cli/src/main.ts",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test && bun run wyrd pack validate packs/fantasy-core"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
